# contacts_manager.py

import json
import csv
import os
import re
from datetime import datetime

# =========================
# Global Contacts Dictionary
# =========================
contacts = {}

DATA_FILE = "contacts.json"
BACKUP_FILE = "contacts_backup.json"


# =========================
# Validation Functions
# =========================

def validate_phone(phone):
    """
    Validate phone number:
    - Must contain only digits
    - Length between 10 and 15
    """
    return phone.isdigit() and 10 <= len(phone) <= 15


def validate_email(email):
    """
    Validate email format using regex
    """
    pattern = r'^[\w\.-]+@[\w\.-]+\.\w+$'
    return re.match(pattern, email)


# =========================
# CRUD Operations
# =========================

def add_contact():
    """
    Add a new contact
    """

    name = input("Enter contact name: ").strip()

    if name in contacts:
        print("❌ Contact already exists!")
        return

    phone = input("Enter phone number: ").strip()

    if not validate_phone(phone):
        print("❌ Invalid phone number!")
        return

    email = input("Enter email: ").strip()

    if not validate_email(email):
        print("❌ Invalid email address!")
        return

    address = input("Enter address: ").strip()
    group = input("Enter group/category (Family/Friends/Work): ").strip()

    contacts[name] = {
        "phone": phone,
        "email": email,
        "address": address,
        "group": group,
        "created_at": str(datetime.now())
    }

    print(f"✅ Contact '{name}' added successfully!")


def search_contact():
    """
    Search contact using partial name matching
    """

    keyword = input("Enter name to search: ").strip().lower()

    found = False

    for name, details in contacts.items():
        if keyword in name.lower():
            found = True
            print("\n---------------------------")
            print(f"Name    : {name}")
            print(f"Phone   : {details['phone']}")
            print(f"Email   : {details['email']}")
            print(f"Address : {details['address']}")
            print(f"Group   : {details['group']}")
            print("---------------------------")

    if not found:
        print("❌ No matching contact found!")


def search_by_phone():
    """
    Search contact by phone number
    """

    phone = input("Enter phone number to search: ").strip()

    for name, details in contacts.items():
        if details["phone"] == phone:
            print("\n✅ Contact Found!")
            print(f"Name    : {name}")
            print(f"Email   : {details['email']}")
            print(f"Address : {details['address']}")
            print(f"Group   : {details['group']}")
            return

    print("❌ Contact not found!")


def update_contact():
    """
    Update existing contact details
    """

    name = input("Enter contact name to update: ").strip()

    if name not in contacts:
        print("❌ Contact not found!")
        return

    print("\nLeave field blank to keep old value.\n")

    new_phone = input("Enter new phone number: ").strip()
    new_email = input("Enter new email: ").strip()
    new_address = input("Enter new address: ").strip()
    new_group = input("Enter new group: ").strip()

    if new_phone:
        if validate_phone(new_phone):
            contacts[name]["phone"] = new_phone
        else:
            print("❌ Invalid phone number!")

    if new_email:
        if validate_email(new_email):
            contacts[name]["email"] = new_email
        else:
            print("❌ Invalid email!")

    if new_address:
        contacts[name]["address"] = new_address

    if new_group:
        contacts[name]["group"] = new_group

    print("✅ Contact updated successfully!")


def delete_contact():
    """
    Delete a contact with confirmation
    """

    name = input("Enter contact name to delete: ").strip()

    if name not in contacts:
        print("❌ Contact not found!")
        return

    confirm = input(f"Are you sure you want to delete '{name}'? (yes/no): ")

    if confirm.lower() == "yes":
        del contacts[name]
        print("✅ Contact deleted successfully!")
    else:
        print("❌ Deletion cancelled.")


def display_all():
    """
    Display all contacts
    """

    if not contacts:
        print("📭 No contacts available!")
        return

    print("\n========== ALL CONTACTS ==========")

    for name, details in contacts.items():
        print(f"""
Name    : {name}
Phone   : {details['phone']}
Email   : {details['email']}
Address : {details['address']}
Group   : {details['group']}
-----------------------------------
""")


# =========================
# File Operations
# =========================

def save_to_file():
    """
    Save contacts to JSON file
    """

    with open(DATA_FILE, "w") as file:
        json.dump(contacts, file, indent=4)

    print("✅ Contacts saved successfully!")


def load_from_file():
    """
    Load contacts from JSON file
    """

    global contacts

    if os.path.exists(DATA_FILE):
        with open(DATA_FILE, "r") as file:
            contacts = json.load(file)

        print("✅ Contacts loaded successfully!")
    else:
        print("📂 No existing contact file found.")


def backup_contacts():
    """
    Create backup of contacts
    """

    with open(BACKUP_FILE, "w") as file:
        json.dump(contacts, file, indent=4)

    print("✅ Backup created successfully!")


def export_to_csv():
    """
    Export contacts to CSV file
    """

    with open("contacts.csv", "w", newline="") as file:
        writer = csv.writer(file)

        writer.writerow([
            "Name",
            "Phone",
            "Email",
            "Address",
            "Group"
        ])

        for name, details in contacts.items():
            writer.writerow([
                name,
                details["phone"],
                details["email"],
                details["address"],
                details["group"]
            ])

    print("✅ Contacts exported to contacts.csv")


# =========================
# Statistics Function
# =========================

def show_statistics():
    """
    Display contact statistics
    """

    total = len(contacts)

    groups = {}

    for details in contacts.values():
        group = details["group"]

        if group in groups:
            groups[group] += 1
        else:
            groups[group] = 1

    print("\n========== STATISTICS ==========")
    print(f"Total Contacts: {total}")

    print("\nContacts by Group:")

    for group, count in groups.items():
        print(f"{group}: {count}")


# =========================
# Main Menu
# =========================

def main_menu():

    load_from_file()

    while True:

        print("""
========== CONTACT MANAGEMENT SYSTEM ==========
1. Add Contact
2. Search Contact
3. Search by Phone Number
4. Update Contact
5. Delete Contact
6. Display All Contacts
7. Save Contacts
8. Backup Contacts
9. Export to CSV
10. Show Statistics
0. Exit
===============================================
""")

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            add_contact()

        elif choice == "2":
            search_contact()

        elif choice == "3":
            search_by_phone()

        elif choice == "4":
            update_contact()

        elif choice == "5":
            delete_contact()

        elif choice == "6":
            display_all()

        elif choice == "7":
            save_to_file()

        elif choice == "8":
            backup_contacts()

        elif choice == "9":
            export_to_csv()

        elif choice == "10":
            show_statistics()

        elif choice == "0":
            save_to_file()
            print("👋 Exiting Contact Management System...")
            break

        else:
            print("❌ Invalid choice! Please try again.")


# =========================
# Program Entry Point
# =========================

if __name__ == "__main__":
    main_menu()